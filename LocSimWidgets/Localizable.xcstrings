    "Shows whether a location is simulated. Tap a favorite to set it in LocSim.": {
      "comment": "Widget description in the widget gallery",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, ob ein Standort simuliert wird. Tippe auf einen Favoriten, um ihn in LocSim zu setzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra si se está simulando una ubicación. Toca un favorito para establecerlo en LocSim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si une position est simulée. Touchez un favori pour le définir dans LocSim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra se è simulata una posizione. Tocca un preferito per impostarlo in LocSim."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont of een locatie wordt gesimuleerd. Tik op een favoriet om deze in LocSim in te stellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra se uma localização está sendo simulada. Toque em um favorito para defini-lo no LocSim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当前是否正在模拟定位。轻点收藏地点可在 LocSim 中直接设置。"
          }
        }
      }
    },
