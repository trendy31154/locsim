    "Opens LocSim and simulates the last location again.": {
      "comment": "Control Center button and intent description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet LocSim und simuliert den letzten Standort erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre LocSim y vuelve a simular la última ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre LocSim et simule à nouveau la dernière position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre LocSim e simula di nuovo l’ultima posizione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent LocSim en simuleert de laatste locatie opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o LocSim e simula a última localização novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 LocSim 并重新模拟上次位置。"
          }
        }
      }
    },
    "Pick the favorites the widget lists. Without a choice it lists the most used ones.": {
      "comment": "Widget settings: description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Favoriten, die das Widget anzeigt. Ohne Auswahl zeigt es die meistgenutzten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los favoritos que muestra el widget. Si no eliges ninguno, muestra los más usados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les favoris affichés par le widget. Sans choix, il affiche les plus utilisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i preferiti mostrati dal widget. Senza una scelta mostra i più usati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de favorieten die de widget toont. Zonder keuze toont hij de meestgebruikte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os favoritos que o widget mostra. Sem escolha, ele mostra os mais usados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择小组件中显示的收藏地点；未选择时默认显示最常用的地点。"
          }
        }
      }
    },
