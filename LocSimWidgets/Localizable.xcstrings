    "Ends the simulated location and restores the real one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet den simulierten Standort und stellt den echten wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la ubicación simulada y restablece la real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met fin à la position simulée et rétablit la position réelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la posizione simulata e ripristina quella reale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beëindigt de gesimuleerde locatie en herstelt de echte."
          }
